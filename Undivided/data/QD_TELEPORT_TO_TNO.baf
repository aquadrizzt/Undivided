// Teleport to TNO (except for Fortress, Tomb, and Player's Maze)
IF 
	!InActiveArea("%character%")
	%teleport_conditions%
	Global("QD_%character%_1900","GLOBAL",2)
THEN
	RESPONSE #100
		MoveGlobalObject("%character%",Protagonist)
		SetGlobal("QD_%character%_1900","GLOBAL",0) 
		ChangeEnemyAlly("%character%",FAMILIAR) 
		ActionOverride("%character%",AddFamiliar())
		SmallWait(1)
		Continue()
END 
