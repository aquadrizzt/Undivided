BACKUP ~Undivided/backup~
AUTHOR ~aquadrizzt@gmail.com~
VERSION ~0.2~


// Thanks to Argent77
ALWAYS 

	// Platform-specific line breaks
	ACTION_IF (~%WEIDU_OS%~ STR_EQ ~win32~) BEGIN
		OUTER_TEXT_SPRINT nl ~%WNL%~
	END ELSE BEGIN
		OUTER_TEXT_SPRINT nl ~%LNL%~
	END

	// Needed for scripts
	APPEND ~STATE.IDS~ ~0x80101FEF CD_STATE_NOTVALID~ UNLESS ~\bCD_STATE_NOTVALID\b~
	APPEND ~OBJECT.IDS~ ~94 LastKilled~ UNLESS ~\bLastKilled\b~
END 


/* Language Settings */
AUTO_TRA ~Undivided/lang/%s~
LANGUAGE ~English~ ~english~ ~Undivided/lang/en_US/setup.tra~


///////////////////////////////////////////////////////////
// Allow NPCs to join as "followers"                     //
///////////////////////////////////////////////////////////
BEGIN @100 
REQUIRE_PREDICATE (GAME_IS ~pstee~) @200 
REQUIRE_PREDICATE (FILE_EXISTS ~Undivided/settings.tpa~) @203 

// Load config file
INCLUDE ~Undivided/settings.tpa~ 
INCLUDE ~Undivided/lib/functions.tph~ 

COPY ~Undivided/data/QD_UNDIVIDED_DIALOG_PATCHES.d~ ~weidu_external~

COPY ~Undivided/data/QDUND1.spl~ ~override~ // follower effects: clear fog of war, min HP, immune to slay/kill, movement speed boost 
	 ~Undivided/data/QDUND2.spl~ ~override~ // remove QDUND1 effects
	 ~Undivided/data/QDUNDM1.spl~ ~override~ // play dead 
	 ~Undivided/data/QDUNDM2.spl~ ~override~ // wake up

//slight change to UI to enable companions to attack
COPY_EXISTING ~ui.menu~ ~override~
	REPLACE_TEXTUALLY ~enabled "buttonArray:GetButtonEnabled(0)"~ ~~
BUT_ONLY

<<<<<<<< .../inlined/Undivided/QD_JOINPARTY.d
ALTER_TRANS %dialog_res% 
BEGIN %state_idx% END 
BEGIN %trans_rel% END 
BEGIN
	"TRIGGER" ~NumInPartyLT(6) !Global("QD_MORTE_1200","GLOBAL",2) %old_trigger%~
END 

EXTEND_TOP %dialog_res% %state_idx% #%trans_rel% 
	%new_transition% 
END 

>>>>>>>>

// check for 1900 accessible areas 
COPY_EXISTING_REGEXP ~.+\.bcs$~ ~override~
	DECOMPILE_AND_PATCH BEGIN
		PATCH_IF (~%SOURCE_RES%~ STRING_COMPARE ~AR1900~) BEGIN 
			PATCH_IF (~%SOURCE_RES%~ STRING_COMPARE ~ACHIEVEM~) BEGIN 
				PATCH_IF (INDEX_BUFFER (~Global("Current_Area","GLOBAL",1900)~) >= 0) BEGIN 
					SPRINT $areas_1900(~%SOURCE_RES%~) ~~
				END 
			END 
		END 
	END 
BUT_ONLY



ACTION_IF (MORTE_FOLLOWER == 1) THEN BEGIN 
	
	INCLUDE ~Undivided/lib/morte.tpa~ 

END 

ACTION_IF (DAKKON_FOLLOWER == 1) THEN BEGIN 
	
	INCLUDE ~Undivided/lib/dakkon.tpa~ 

END 



ACTION_IF (ANNAH_FOLLOWER == 1) THEN BEGIN 
	
	INCLUDE ~Undivided/lib/annah.tpa~ 

END 

ACTION_IF (IGNUS_FOLLOWER == 1) THEN BEGIN 
	
	INCLUDE ~Undivided/lib/ignus.tpa~ 

END 

ACTION_IF (GRACE_FOLLOWER == 1) THEN BEGIN 
	
	INCLUDE ~Undivided/lib/grace.tpa~ 

END 

ACTION_IF (NORDOM_FOLLOWER == 1) THEN BEGIN 
	
	INCLUDE ~Undivided/lib/nordom.tpa~ 

END 

ACTION_IF (VHAILOR_FOLLOWER == 1) THEN BEGIN 
	
	INCLUDE ~Undivided/lib/vhailor.tpa~ 

END 

COMPILE ~weidu_external/QD_UNDIVIDED_DIALOG_PATCHES.d~
