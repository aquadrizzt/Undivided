OUTER_SPRINT dlg_file ~DMORTE~ 
OUTER_SPRINT character ~MORTE~ 
OUTER_SPRINT play_dead_sound ~MRT075A~ 
OUTER_SPRINT fortress_variable ~Fortress_Morte~ 
OUTER_SET fortress_spawn_y = 1243
OUTER_SET fortress_spawn_x = 1048
OUTER_SPRINT teleport_conditions ~!Global("Morte_Stolen","GLOBAL",1) !Global("Sold_Morte","GLOBAL",2)~ 
OUTER_SPRINT fortress_reflection_check ~~ 

COPY_EXISTING ~DMORTE.DLG~ ~override~
	LPF qd_update_joins STR_VAR character = EVAL ~%character%~ END 

// included for completeness but shouldn't actually come up
// mortuary tutorial dialogs 
COPY_EXISTING ~DMORTE1.DLG~ ~override~
	LPF qd_update_joins STR_VAR character = EVAL ~%character%~ END 

COPY_EXISTING ~DMORTE2.DLG~ ~override~
	LPF qd_update_joins STR_VAR character = EVAL ~%character%~ END 

COMPILE ~Undivided/data/QD_MORTE_LEAVE.d~

// can skip global trick for morte

COPY_EXISTING_REGEXP ~.+\.bcs$~ ~override~
	DECOMPILE_AND_PATCH BEGIN
		REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH 
		~!InParty("%character%")~ 
		~!InParty("%character%_KRANGLED")~  

		REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH 
		~InParty("%character%")~ 
		~OR(2) InParty("%character%") Global("QD_%character%_FOLLOWER","GLOBAL",1)~

		REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH ~!InParty("%character%_KRANGLED")~ 
		~!InParty("%character%") Global("QD_%character%_FOLLOWER","GLOBAL",0)~
	END
BUT_ONLY

ACTION_PHP_EACH areas_1900 AS script => _ BEGIN 
	EXTEND_TOP ~%script%.bcs~ ~Undivided/data/QD_TELEPORT_TO_TNO.baf~ EVAL
END 

COPY_EXISTING_REGEXP ~.+\.dlg~ ~override~
	DECOMPILE_AND_PATCH BEGIN
		REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH 
		~!InParty("%character%")~ 
		~!InParty("%character%_KRANGLED")~  

		REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH 
		~InParty("%character%")~ 
		~OR(2) InParty("%character%") Global("QD_%character%_FOLLOWER","GLOBAL",1)~

		REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH ~!InParty("%character%_KRANGLED")~ 
		~!InParty("%character%") Global("QD_%character%_FOLLOWER","GLOBAL",0)~

		REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH 
		~!NearbyDialog("%dlg_file%")~ 
		~StateCheck("%character%", CD_STATE_NOTVALID)~ 

		REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH 
		~NearbyDialog("%dlg_file%")~ 
		~!StateCheck("%character%", CD_STATE_NOTVALID)~ 
	END
BUT_ONLY



// Tomb of the Nameless and Drowned Nations rejoin
EXTEND_TOP ~ar1800.bcs~ ~Undivided/data/QD_UNDIVIDED_1800.baf~ EVAL 

EXTEND_TOP ~ar1700.bcs~ ~Undivided/data/QD_UNDIVIDED_1700.baf~ EVAL 

// Player Maze 
EXTEND_TOP ~ar1900.bcs~ ~Undivided/data/QD_UNDIVIDED_1900.baf~ EVAL 

// Fortress of Regrets
EXTEND_TOP ~ar1200.bcs~ ~Undivided/data/QD_UNDIVIDED_1200.baf~ EVAL 

EXTEND_BOTTOM ~ar1204.bcs~ ~Undivided/data/QD_UNDIVIDED_1204.baf~ EVAL 

EXTEND_BOTTOM ~pcmorte.bcs~ ~Undivided/data/QD_FOLLOWER_SCRIPT.baf~ EVAL

// Morte's Return Cutscene 
COMPILE ~Undivided/data/QD0500M.baf~ EVAL

COPY_EXISTING_REGEXP ~ar0500.bcs~ ~override~
	DECOMPILE_AND_PATCH BEGIN
		REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH 
		~ Global("Morte_Stolen","GLOBAL",2)~ 
		~ Global("Morte_Stolen","GLOBAL",2) Global("QD_MORTE_FOLLOWER","GLOBAL",0)~  
	END
BUT_ONLY

EXTEND_BOTTOM ~ar0500.bcs~ ~Undivided/data/QD_0500_CUTSCENE.baf~ EVAL 